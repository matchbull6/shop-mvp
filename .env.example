# token from @BotFather
BOT_TOKEN=
# telegram ids of admins, comma separated, e.g. 123456789,987654321
ADMIN_IDS=

# email for Let's Encrypt certificate notifications
ACME_EMAIL=
# your domain without https://, e.g. shop.example.com
DOMAIN=

# random strings, generate each with: openssl rand -hex 32
WEBHOOK_SECRET=
API_KEY=
POSTGRES_PASSWORD=
MINIO_ROOT_PASSWORD=
