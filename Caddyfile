{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	handle /bot/webhook {
		reverse_proxy {
			dynamic a bot 8080 {
				refresh 10s
			}
			lb_policy round_robin
			lb_try_duration 5s
		}
	}

	handle /api/* {
		request_body {
			max_size 10MB
		}
		reverse_proxy {
			dynamic a backend 8000 {
				refresh 10s
			}
			lb_policy round_robin
			lb_try_duration 5s
		}
	}

	handle {
		reverse_proxy {
			dynamic a frontend 3000 {
				refresh 10s
			}
			lb_policy round_robin
			lb_try_duration 5s
		}
	}
}
